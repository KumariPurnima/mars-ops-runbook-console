# DigitalOcean personal access token or model access key
# Used for Gradient Serverless Inference enrichment in simulated mode
DO_API_KEY=

# DO token used by the console to read MARS sessions / executions
DO_API_TOKEN=

# Shared secret agents present when POSTing /api/agent/callback
AGENT_CALLBACK_TOKEN=

# From scripts/setup-mars.sh
MARS_TRIAGE_TRIGGER_ID=
MARS_TRIAGE_TRIGGER_SECRET=
MARS_RUNBOOK_TRIGGER_ID=
MARS_RUNBOOK_TRIGGER_SECRET=

# Optional: force offline replay even when MARS is configured
FORCE_REPLAY=0

# Model id (Serverless Inference / harness env)
INFERENCE_MODEL=openai-gpt-4.1
