# DigitalOcean personal access token or model access key
# Used for Gradient Serverless Inference (https://inference.do-ai.run)
DO_API_KEY=

# Optional: force offline replay even when a key is present
FORCE_REPLAY=0

# Optional model id from GET https://inference.do-ai.run/v1/models
INFERENCE_MODEL=openai-gpt-4.1
